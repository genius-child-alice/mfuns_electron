{
  "name": "mfuns-electron",
  "version": "1.0.0",
  "description": "Mfuns Electron desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "node scripts/sync-material-icons.js && npm run vendor:quill",
    "vendor:quill": "esbuild node_modules/quill/quill.js --bundle --format=esm --outfile=src/vendor/quill.mjs"
  },
  "build": {
    "appId": "net.mfuns.desktop",
    "productName": "Mfuns",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "src/assets/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "esbuild": "^0.25.0",
    "material-symbols": "^0.47.4"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "hls.js": "^1.7.3",
    "marked": "^18.0.13",
    "quill": "^2.0.3"
  }
}
